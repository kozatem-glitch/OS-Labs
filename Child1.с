#include <ctype.h>
#include <unistd.h>
#include <stdlib.h>
#include <stdint.h>

void error(const char* msg, size_t len)
{
	write(STDERR_FILENO, msg, len);
	exit(EXIT_FAILURE);
}
int main()
{
	char buf[4096];
	ssize_t i = 0, n = 0, written = 0, w = 0;
	while ((n = read(STDIN_FILENO, buf, sizeof(buf))) > 0)
	{
		for (i = 0; i < n; i++)
		{
			buf[i] = toupper((unsigned char)buf[i]);
		}
	
		written = 0;

		while (written < n)
		{
			w = write(STDOUT_FILENO, buf + written, n - written);
			if (w <= 0)
			{
				const char msg[] = "Write to stdout failed\n";
				error(msg, sizeof(msg) - 1);
			}
			written += w;
		}	
	}

	if (n == -1)
	{
		const char msg[] = "Read from stdin failed\n";
		error(msg, sizeof(msg) - 1);
	}
		
	return 0;
}